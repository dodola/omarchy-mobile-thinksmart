# SPDX-License-Identifier: MIT
# Merge after the pinned kernel's arm64 defconfig and msm8953.config.
# Early boot needs these without loading modules from persistent storage.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=y
# CONFIG_EXT2_FS is not set
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_UNIX=y
CONFIG_INET=y
# A single-slot failure must wait for its owner instead of looping.
CONFIG_PANIC_TIMEOUT=0
# These remain modules: their hardware gates have not run on this port.
CONFIG_DRM_MSM=m
CONFIG_DRM_PANEL_MSM8953_GENERATED=m
CONFIG_DRM_PANEL_LENOVO_CD_18781Y_FT8201=m
CONFIG_DRM_PANEL_LENOVO_CD_18781Y_HX83100A=m
