# SPDX-License-Identifier: MIT
# Merge after the pinned kernel's arm64 defconfig and msm8953.config.
# Early boot needs these without loading modules from persistent storage.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=y
# CONFIG_EXT2_FS is not set
CONFIG_EXT4_USE_FOR_EXT2=y
CONFIG_OVERLAY_FS=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EFI_PARTITION=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_MSM=y
CONFIG_SERIAL_MSM=y
CONFIG_SERIAL_MSM_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_UNIX=y
CONFIG_INET=y
# Give the revised configuration a distinct module directory.
CONFIG_LOCALVERSION="-thinksmart1"
# Arch's iptables uses nftables, including for `iptables --version`.
# Omamobile firstboot configures UFW; arm64 defconfig alone lacks this API.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_NAT=m
CONFIG_IP6_NF_IPTABLES=m
# Match/target support used by UFW's IPv4 and IPv6 before/after rules.
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_OWNER=m
CONFIG_IP6_NF_MATCH_RT=m
CONFIG_NETFILTER_XT_TARGET_LOG=m
CONFIG_NETFILTER_XT_MATCH_LIMIT=m
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_RECENT=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_HL=m
# A single-slot failure must wait for its owner instead of looping.
CONFIG_PANIC_TIMEOUT=0
# These remain modules: their hardware gates have not run on this port.
CONFIG_DRM_MSM=m
CONFIG_DRM_PANEL_MSM8953_GENERATED=m
CONFIG_DRM_PANEL_LENOVO_CD_18781Y_FT8201=m
CONFIG_DRM_PANEL_LENOVO_CD_18781Y_HX83100A=m
