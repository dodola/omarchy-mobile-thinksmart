#!/bin/sh
# SPDX-License-Identifier: MIT
# Experimental lk2nd handoff with a read-only base and an optional data mapper.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
mount -t proc proc /proc || exit 1
mount -t sysfs sysfs /sys || exit 1
mount -t devtmpfs devtmpfs /dev || exit 1
exec </dev/console >/dev/console 2>&1
mkdir -p /run /dev/pts /lower /newroot
mount -t tmpfs -o mode=0755 tmpfs /run || exit 1
mount -t devpts devpts /dev/pts || exit 1

say() { echo "omamobile-thinksmart: $*"; }
stop() {
    rm -f /run/omamobile-thinksmart/writable
    /guard once || {
        echo 0 >/proc/sys/kernel/panic
        echo c >/proc/sysrq-trigger
    }
    say "$*; STOPPED, no reboot or storage recovery is attempted"
    while :; do sleep 60; done
}

# Also used after switch_root. It has its own static executable in /run,
# so switch_root removing the initramfs cannot remove the guard's tools.
mkdir -p /run/omamobile-thinksmart
cp /bin/busybox /run/omamobile-thinksmart/busybox || exit 1
cp /guard /run/omamobile-thinksmart/guard || exit 1
cmdline=" $(cat /proc/cmdline) "
persistent=0
case "$cmdline" in
    *' omamobile.initramfs '*) ;;
    *' omamobile.persist '*) persistent=1 ;;
esac
start_guard() {
    /guard once || stop 'storage protection failed'
    /guard &
    early_guard=$!
}
if [ "$persistent" = 0 ]; then
    start_guard
else
    [ -x /persistence ] && [ -x /bin/thinksmart-map ] || stop 'persistent entry is unavailable'
    . /persistence
fi
say "experimental boot, kernel $(uname -r)"
case "$cmdline" in
    *' omamobile.initramfs '*)
        say 'diagnostic shell; every block device is read-only'
        while :; do /bin/sh </dev/console >/dev/console 2>&1; sleep 1; done
        ;;
esac

system=''
for attempt in $(seq 1 30); do
    count=0
    for entry in /sys/class/block/mmcblk*/uevent; do
        [ -r "$entry" ] || continue
        if grep -qx 'PARTNAME=system' "$entry"; then
            # uevent is data, never shell input.
            name=${entry%/uevent}; name=${name##*/}
            system=/dev/$name
            count=$((count + 1))
        fi
    done
    [ "$count" -le 1 ] || stop 'more than one eMMC system partition'
    [ "$count" = 1 ] && break
    sleep 1
done
[ -b "$system" ] || stop 'no eMMC system partition'

# Only a nested image with the exact geometry produced by the offline
# packer can be used. Never interpret the outer eMMC as an MBR image.
. /etc/thinksmart-layout
[ "$(od -An -tx2 -j 510 -N 2 "$system" | tr -d ' \n')" = aa55 ] || stop 'nested MBR signature missing'
set -- $(od -An -tu4 -j 470 -N 8 "$system")
[ "$#" = 2 ] && [ "$1" = 512000 ] && [ "$2" = "$ROOT_SECTORS" ] || stop 'nested root geometry differs'
if [ "$persistent" = 1 ]; then
    check_persistence_layout || stop 'persistent layout differs'
    # Device-mapper needs its backing reference opened before BLKROSET.
    # PID 1 has launched no services, shell or filesystem writer at this point.
    create_persistence_mapper || stop 'could not create bounded overlay mapping'
    start_guard
fi
/guard once || stop 'eMMC protection failed'
[ "$(blockdev --getro "$system")" = 1 ] || stop 'system is writable'
loop=$(losetup -f) || stop 'no free loop device'
# BusyBox can scan partitions on a read-only loop but has no --sizelimit.
# Use the kernel's bounded second partition rather than an offset-only loop.
losetup -r -P "$loop" "$system" || stop 'read-only system mapping failed'
[ "$(blockdev --getro "$loop")" = 1 ] || stop 'loop is writable'
root=${loop}p2
entry=/sys/class/block/${root##*/}
[ -b "$root" ] || stop 'nested root partition missing'
[ "$(cat "$entry/start")" = 512000 ] &&
    [ "$(cat "$entry/size")" = "$ROOT_SECTORS" ] || stop 'mapped root geometry differs'
[ "$(blockdev --getro "$root")" = 1 ] || stop 'nested root is writable'
mount -t ext4 -o ro,noload "$root" /lower || stop 'root mount failed'
[ -x /lower/usr/lib/systemd/systemd ] || stop 'root has no systemd'

mkdir -p /run/overlay
if [ "$persistent" = 1 ]; then
    mount_persistence || stop 'persistent data mount failed'
else
    mount -t tmpfs -o size=512m,mode=0755 tmpfs /run/overlay || stop 'RAM overlay unavailable'
fi
mkdir -p /run/overlay/upper /run/overlay/work || stop 'overlay directories unavailable'
mount -t overlay overlay -o lowerdir=/lower,upperdir=/run/overlay/upper,workdir=/run/overlay/work /newroot || stop 'overlay mount failed'
mkdir -p /newroot/run /newroot/proc /newroot/sys /newroot/dev
if [ -f /etc/thinksmart-firstboot.conf ] &&
    [ ! -e /newroot/var/lib/omamobile/firstboot/done ] &&
    [ ! -e /newroot/etc/omamobile/firstboot.conf ]; then
    mkdir -p /newroot/etc/omamobile
    (umask 077; cp /etc/thinksmart-firstboot.conf /newroot/etc/omamobile/.firstboot.new &&
        mv /newroot/etc/omamobile/.firstboot.new /newroot/etc/omamobile/firstboot.conf) ||
        stop 'firstboot configuration failed'
fi
mount --move /run /newroot/run || stop 'run handoff failed'
mount --move /proc /newroot/proc || exit 1
mount --move /sys /newroot/sys || exit 1
mount --move /dev /newroot/dev || exit 1

# Start and verify the guard in its final root before retiring the early
# watcher. It scans the merged root's sysfs and devtmpfs after handoff.
chroot /newroot /run/omamobile-thinksmart/busybox sh /run/omamobile-thinksmart/guard once || exit 1
chroot /newroot /run/omamobile-thinksmart/busybox sh /run/omamobile-thinksmart/guard &
kill "$early_guard"
exec switch_root /newroot /usr/lib/systemd/systemd
