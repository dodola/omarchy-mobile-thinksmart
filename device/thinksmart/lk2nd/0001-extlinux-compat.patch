 /**
+ * count_lines() - Count the amount of lines in the string.
+ */
+static int count_lines(char *data, size_t size)
+{
+	int acc = 0;
+	size_t i;
+
+	for (i = 0; i < size; ++i) {
+		if (data[i] == '\n')
+			acc++;
+
+		if (data[i] == '\0')
+			break;
+	}
+
+	return acc;
+}
