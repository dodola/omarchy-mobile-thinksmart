--- a/lk2nd/display/simplefb.c
+++ b/lk2nd/display/simplefb.c
@@ -68,15 +68,33 @@
 	if (resmem_offset < 0)
 		return 0;
 
-	// TODO: Probably want to check if the node already exists
+	/* Board DTs may already reserve the bootloader framebuffer. */
 	snprintf(tmp, sizeof(tmp), "cont-splash@%08x", (uint32_t)fb->base);
-	offset = fdt_add_subnode(dtb, resmem_offset, tmp);
-	if (offset < 0)
+	offset = fdt_subnode_offset(dtb, resmem_offset, tmp);
+	if (offset == -FDT_ERR_NOTFOUND) {
+		offset = fdt_add_subnode(dtb, resmem_offset, tmp);
+		if (offset < 0)
+			return 0;
+
+		ret = fdt_appendprop_addrrange(dtb, resmem_offset, offset, "reg",
