-		return 0;
+	}
 
 	ret = fdt_setprop_empty(dtb, offset, "no-map");
 	if (ret < 0)
@@ -168,6 +186,9 @@
 	if (ret < 0)
 		return 0;
 
+	dprintf(INFO, "simplefb: Published %ux%u framebuffer, %u bpp at %#x\n",
